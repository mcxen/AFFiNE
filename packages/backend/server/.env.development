# AFFiNE Server Development Environment
NODE_ENV=development
AFFINE_ENV=dev

# Server
AFFINE_SERVER_PORT=3010
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010
LISTEN_ADDR=0.0.0.0

# Database
DATABASE_URL=postgresql://affine:affine@localhost:5432/affine

# Redis
REDIS_SERVER_HOST=localhost
REDIS_SERVER_PORT=6379
REDIS_SERVER_DATABASE=0

# Disable AI features by default (optional)
# COPILOT_OPENAI_API_KEY=

# Disable email by default (optional)
# MAILER_HOST=
# MAILER_PORT=

# Enable debugging
DEBUG=affine:*
FORCE_COLOR=true
DEBUG_COLORS=true
