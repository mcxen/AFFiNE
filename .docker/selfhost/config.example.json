{
  "server": {
    "name": "AFFiNE Self Hosted Server"
  },
  "copilot": {
    "enabled": true,
    "byok.enabled": true,
    "byok.allowedProviders": [
      "openai",
      "anthropic",
      "gemini",
      "fal"
    ],
    "byok.allowCustomEndpoint": true,
    "providers.profiles": [
      {
        "id": "openai-compat",
        "type": "openai",
        "displayName": "OpenAI Compatible API",
        "enabled": true,
        "priority": 100,
        "config": {
          "apiKey": "YOUR_API_KEY",
          "baseURL": "https://api.openai.com/v1"
        }
      }
    ],
    "providers.defaults": {
      "text": "openai-compat",
      "object": "openai-compat",
      "embedding": "openai-compat",
      "structured": "openai-compat",
      "fallback": "openai-compat"
    }
  }
}
